# 설치 폴더를 기준으로 한 현재 정상 서버 JAR입니다.
active.version=@VERSION@
active.jar=versions/attendance-@VERSION@.jar

# Java 17 이상이 설치되어 PATH에서 java 명령을 찾을 수 있어야 합니다.
java.command=java

# 서버를 시작할 때만 최신 버전을 한 번 확인합니다. 운영 중 주기 확인은 하지 않습니다.
update.manifestUrl=https://bgrc.howmanycals.online/stable/manifest.json
# Ed25519 공개키(X.509 DER의 Base64). 배포 패키징 시 Gradle 속성으로 주입한다.
# 개인키는 이 파일이나 Ubuntu 서버에 두지 않습니다.
update.publicKeyBase64=@UPDATE_PUBLIC_KEY@
update.connectTimeoutSeconds=3
update.readTimeoutSeconds=5
update.downloadTimeoutSeconds=120

# 새 버전 기동 검증용 API입니다.
server.healthUrl=http://127.0.0.1:8080/api/version
server.startupTimeoutSeconds=45
